generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECRUITER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
  HYBRID
}

enum SectionType {
  HERO
  ABOUT_US
  IMAGE_TEXT
  CULTURE_VIDEO
  VALUES
  PERKS_BENEFITS
  GALLERY
  CUSTOM_TEXT
  OPEN_ROLES
  CTA
}

model Company {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  logoUrl         String?
  bannerUrl       String?
  website         String?
  industry        String?
  companySize     String?
  location        String?
  description     String?
  cultureVideoUrl String?
  primaryColor    String        @default("#2563eb")
  secondaryColor  String        @default("#1e293b")
  fontFamily      String        @default("Inter")
  tagline         String?
  aboutText       String?
  cornerRadius     Int           @default(12)
  sectionSpacing   String        @default("3.5rem")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users           User[]
  careersPages    CareersPage[]
  sections        PageSection[]
  jobs            Job[]
  departments     Department[]
  locations       Location[]
  mediaAssets     Media[]

  @@index([slug])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(RECRUITER)
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model CareersPage {
  id              String        @id @default(cuid())
  companyId       String        @unique
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  sections        PageSection[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PageSection {
  id            String      @id @default(cuid())
  careersPageId String
  careersPage   CareersPage @relation(fields: [careersPageId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          SectionType
  title         String?
  content       Json        @default("{}")
  layoutVariant String      @default("01")
  orderIndex    Int         @default(0)
  enabled       Boolean     @default(true)
  isDraft       Boolean     @default(true)
  isPublished   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId])
  @@index([careersPageId])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs      Job[]
  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  isRemote  Boolean  @default(false)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs      Job[]
  createdAt DateTime @default(now())

  @@unique([name, companyId])
}

model Job {
  id           String      @id @default(cuid())
  title        String
  slug         String
  description  String?
  jobType      JobType     @default(FULL_TIME)
  isPublished  Boolean     @default(true)
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([slug])
}

model Media {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url       String
  type      String   @default("image")
  altText   String?
  createdAt DateTime @default(now())

  @@index([companyId])
}
